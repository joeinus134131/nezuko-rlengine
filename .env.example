# Copy ke .env di VPS (jangan commit). GitHub Secrets pakai nama yang sama.
# Production: cukup isi DATABASE_URL + APP_SECRET_KEY.

# Opsi 1 — connection string penuh (Recommended, cocok untuk managed DB juga)
DATABASE_URL=postgresql+psycopg2://nezu:CHANGE_ME@postgres-host:5432/nezu?sslmode=require

# Untuk PostgreSQL lokal tanpa TLS gunakan sslmode=prefer.
# DATABASE_URL=postgresql+psycopg2://nezu:CHANGE_ME@127.0.0.1:5432/nezu?sslmode=prefer

# Opsi 2 — pecahan (dipakai kalau DATABASE_URL kosong)
#POSTGRES_HOST=
#POSTGRES_PORT=5432
#POSTGRES_DB=nezu
#POSTGRES_USER=nezu
#POSTGRES_PASSWORD=CHANGE_ME

# Wajib untuk enkripsi secrets di tabel `secrets`.
# Generate: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_SECRET_KEY=CHANGE_ME_GENERATE_FERNET_KEY
